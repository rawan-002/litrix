# =====================================================
# Litrix Scraper Environment Variables
# Copy this file to `.env` (in the same folder) and fill in real values.
# NEVER commit the actual .env file to git.
# =====================================================

# --- SerpAPI (Google Scholar access) ---
SERP_API_KEY=your_serpapi_key_here

# --- Polite contact for CrossRef API (gives you better rate limits) ---
CONTACT_EMAIL=ra20awn@gmail.com

# --- PostgreSQL ---
DB_NAME=LitrixDB
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# --- Default ranking year for Scimago lookups ---
RANKING_YEAR=2024
