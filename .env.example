# Django core
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=generate_with_get_random_secret_key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

SERP_API_KEY=your_serpapi_key_here

# Litrix AI chat (analytics/ai_views.py). Free key from https://console.groq.com
# - open-source models (Llama/Mistral) served via Groq's free-tier API, not
# a paid Anthropic/OpenAI account. Chat replies "not configured yet" without it.
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the model if the default is retired - check current
# free-tier model names at https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

CONTACT_EMAIL=your_email@example.com

DB_NAME=LitrixDB
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_HOST=localhost
DB_PORT=5432

DATABASE_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require

RANKING_YEAR=2025
