  "IpAddress" varchar(64)
  "UserAgent" text
  "CreatedAt" timestamptz
}

Table "AuthorReviewQueue" {
  "ReviewID" int [pk]
  "PaperID" int [not null]
  "ScrapedName" varchar(255) [not null]
  "ScrapedAffiliation" varchar(255)
  "SuggestedUserID" int
  "SuggestedConfidence" numeric [not null]
  "SuggestedCriteria" varchar(50) [not null]
  "Status" varchar(20) [not null]
  "ReviewedByUserID" int
  "ReviewedAt" timestamptz
  "ReviewerNotes" text
  "CreatedAt" timestamptz [not null]
}

Table "Authors" {
  "UserID" int
  "PaperID" int [not null]
  "AuthorOrder" int
  "IsCorrespondingAuthor" boolean
  "MappingConfidence" float
  "MappingCriteria" varchar(255)
  "AuthorLinkID" int [pk]
  "AuthorNameRaw" text
  "Is_Verified" boolean
  indexes {
    "PaperID" [name: "ix_authors_paper"]
    // Blocks double-linking the same researcher to the same paper after
    // disambiguation. PK is the surrogate AuthorLinkID, so this is what
    // actually enforces (UserID, PaperID) uniqueness. External/unmatched
    // authors carry UserID = NULL and don't collide (NULLs are distinct).
    ("UserID", "PaperID") [unique, name: "uq_authors_user_paper"]
  }
}

