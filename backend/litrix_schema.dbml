Table "ResearchPaper" {
  "PaperID" int [pk]
  "JournalID" int
  "Title" text [not null]
  "Title_En" text
  "Abstract" text
  "Abstract_En" text
  "Language" varchar(10)
  "DOI" varchar(100)
  "PubYear" int
  "Volume" varchar(50)
  "Issue" varchar(50)
  "Pages" varchar(100)
  "IsVerified" boolean
  "ScrapedAt" timestamptz
  "Source" varchar(100)
  "RawData_Log" jsonb
  "SearchVector_En" tsvector
  "SearchVector_Ar" tsvector
  "NormalizedTitle" text
  "Indexing" varchar(50)
  "CitationsByYear" jsonb
  "TenantID" int
  "AffiliationVerified" boolean
  "VerificationSource" varchar(20)
  "VerifiedAt" timestamp
  "VerificationDetails" jsonb
  indexes {
    // DOI is the strongest natural key against duplicate papers. Partial so
    // the many DOI-less papers (NULL) don't collide. ResearchPaper_DOI_key
    // (a plain UNIQUE(DOI)) duplicates this and is redundant.
    "DOI" [unique, name: "uq_paper_doi", note: "partial: WHERE DOI IS NOT NULL"]
    // Title-based fallback dedupe for the DOI-less papers.
    "NormalizedTitle" [unique, name: "uq_paper_normalized_title", note: "partial: WHERE NormalizedTitle IS NOT NULL"]
    "Title" [unique, name: "researchpaper_title_unique"]
    "JournalID" [name: "ix_researchpaper_journal"]
    "TenantID" [name: "idx_paper_tenant"]
    "Indexing" [name: "ix_research_paper_indexing"]
    "AffiliationVerified" [name: "idx_paper_affiliation_verified"]
  }
}

